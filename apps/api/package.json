{
  "name": "@dracin/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "echo 'api: no build step (bun runs TS directly)'",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "sync:full": "bun src/scripts/sync-full.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@dracin/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.6.0"
  }
}
